# Copiez ce fichier en « .env » puis complétez. Sans configuration, l'application
# fonctionne avec des offres d'exemple et des envois simulés (fichiers .eml).

# --- Offres réelles : API France Travail (gratuite) ---
# 1. Créez un compte sur https://francetravail.io
# 2. Créez une application et abonnez-la à l'API « Offres d'emploi v2 »
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=

# --- Envoi réel des e-mails (exemple Gmail) ---
# Gmail : activez la validation en 2 étapes puis créez un « mot de passe d'application »
# sur https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Adresse d'expédition (par défaut : l'e-mail de votre profil)
SMTP_FROM=
