# Copiez ce fichier en « .env » puis complétez. Sans configuration, l'application
# affiche déjà les vraies offres suisses (job-room.ch) et SIMULE les envois
# (fichiers .eml dans data/outbox).

# --- Envoi réel des e-mails ---
# Gmail : activez la validation en 2 étapes puis créez un « mot de passe d'application »
# sur https://myaccount.google.com/apppasswords
# Autres fournisseurs : Infomaniak mail.infomaniak.com (465), Bluewin/Swisscom smtpauths.bluewin.ch (465)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Adresse d'expédition (par défaut : l'e-mail de votre profil)
SMTP_FROM=

# --- Mode démonstration (offres fictives, sans connexion) ---
# OFFRES_DEMO=1
